rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Drafter provisioning writes this signed claim together with the profile role.
    // Storage authorization does not consume Firestore reads.
    function isDrafter() {
      return request.auth != null && request.auth.token.get('role', '') == 'drafter';
    }
    function canManageBOQ() {
      return request.auth != null && (request.auth.token.get('role', '') in ['drafter', 'admin', 'qc_dme']
        || request.auth.token.get('email', '') == 'qcdme@dme.com');
    }
    match /boq_photos/{itemId}/{photoId} {
      allow read: if canManageBOQ();
      allow create, update: if canManageBOQ()
        && itemId.matches('room-v1-(room|no-room)-[0-9]+') && photoId.matches('[0-9a-f]{64}')
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.metadata.uploadedBy == request.auth.uid && request.resource.metadata.sha256 == photoId
        && (resource == null || resource.metadata.uploadedBy == request.auth.uid);
      allow delete: if canManageBOQ();
    }
    
    // ============================================================
    // HSE Reports — PDF yang di-share via WhatsApp
    // PUBLIC READ dipertahankan supaya link WA bisa dibuka siapapun
    // ============================================================
    match /hse_reports/{fileName} {
      // ✅ Public read — link WA bisa dibuka tanpa login
      allow read: if true;
      
      // ✅ Write hanya untuk authenticated user
      // - Max 10MB (dikurangi dari 20MB untuk efisiensi)
      // - Hanya file PDF
      allow write: if request.auth != null && !isDrafter()
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // ============================================================
    // SILO Documents — Upload PDF dokumen Surat Izin Layak Operasi
    // SECURITY: Restricted to authenticated users (Wave 7 Hardening)
    // ============================================================
    match /silo/{fileName} {
      // ✅ Restricted read — only logged in users can see SILO documents
      allow read: if request.auth != null && !isDrafter();
      
      // ✅ Write hanya untuk authenticated user, max 10MB
      allow write: if request.auth != null && !isDrafter()
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
    // ============================================================
    // PTW Files — Lampiran dokumen Permit to Work
    // ============================================================
    match /ptw_files/{ptwNumber}/{fileName} {
      allow read: if request.auth != null && !isDrafter();
      allow write: if request.auth != null && !isDrafter()
                   && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if request.auth != null && !isDrafter();
    }

    // ============================================================
    // DEFAULT — Blokir semua akses ke path lain
    // ============================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
