rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdminSafe() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStandbyEngineer() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'standby_engineer';
    }

    function isHSE() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hse';
    }

    function isDirector() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dirut' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'direksiSDM' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DireksiKeuangan');
    }

    function isEngineer() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'engineer' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'standby_engineer' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tde' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cbre');
    }

    function isPrivilegedRole() {
       return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'site_manager', 'hse', 'dirut', 'direksiSDM', 'DireksiKeuangan'];
    }

    function isDivision(div) {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == div;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidPhotoData(data) {
      return data is string && data.size() <= 2800000;
    }
    
    function hasAcceptableFieldCount(data, maxFields) {
      return data.keys().size() <= maxFields;
    }

    match /users/{userId} {
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasAll(['email', 'uid', 'role', 'companyType', 'createdAt'])
                    && hasAcceptableFieldCount(request.resource.data, 8)
                    && request.resource.data.role == 'engineer'
                    && (request.resource.data.companyType == 'neutra' || request.resource.data.companyType == 'bri')
                    && isValidString(request.resource.data.email, 200)
                    && isValidString(request.resource.data.uid, 128);
      
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (isAdminSafe() || isStandbyEngineer());
      
      allow update: if request.auth != null 
                    && (
                      (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyType']))
                      || isAdminSafe()
                    )
                    && hasAcceptableFieldCount(request.resource.data, 10);
      
      allow delete: if request.auth != null && isAdminSafe();
    }
    
    match /excel_documents/{docId} {
      allow create: if request.auth != null 
                    && request.resource.data.createdBy == request.auth.token.email
                    && request.resource.data.keys().hasAll([
                      'fileName', 
                      'maintenanceName', 
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'fileSize',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 15)
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.maintenanceName, 500)
                    && isValidString(request.resource.data.createdBy, 200)
                    && (!request.resource.data.keys().hasAny(['specificDetail']) || request.resource.data.specificDetail is string);
      
      allow read, delete: if request.auth != null 
                  && (resource.data.createdBy == request.auth.token.get('email', '') 
                      || resource.data.createdBy == request.auth.token.email
                      || isPrivilegedRole());
      
      allow update: if request.auth != null 
                    && (resource.data.createdBy == request.auth.token.email || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 15);

      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 6)
                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/excel_documents/$(docId)).data.createdBy == request.auth.token.email || isPrivilegedRole());
      }
    }
    
    match /pdf_documents/{docId} {
      allow create: if request.auth != null 
                    && request.resource.data.createdBy == request.auth.token.email
                    && request.resource.data.keys().hasAll([
                      'fileName', 
                      'maintenanceName', 
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'fileSize',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 15)
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.maintenanceName, 500)
                    && isValidString(request.resource.data.createdBy, 200)
                    && (!request.resource.data.keys().hasAny(['specificDetail']) || request.resource.data.specificDetail is string);
      
      allow read, delete: if request.auth != null 
                  && (resource.data.createdBy == request.auth.token.email 
                      || resource.data.createdBy == request.auth.token.get('email', '')
                      || isPrivilegedRole());
      
      allow update: if request.auth != null 
                    && (resource.data.createdBy == request.auth.token.email || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 15);

      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 6)
                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/pdf_documents/$(docId)).data.authorEmail == request.auth.token.email || isPrivilegedRole());
      }
    }
    
    match /files/{fileId} {
      allow create: if request.auth != null && (isAdminSafe() || isEngineer())
                    && request.resource.data.keys().hasAll([
                      'fileName',
                      'fileSize',
                      'fileType',
                      'category',
                      'uploadedBy',
                      'uploadedByEmail',
                      'uploadedAt'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 20)
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.uploadedByEmail == request.auth.token.email
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.fileType, 100);
      
      allow read: if request.auth != null;
      
      allow update: if request.auth != null 
                    && isAdminSafe()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      
      allow delete: if request.auth != null && isAdminSafe();

      match /chunks/{chunkId} {
        allow create: if request.auth != null 
                      && (isAdminSafe() || isEngineer())
                      && hasAcceptableFieldCount(request.resource.data, 10);
        
        allow read: if request.auth != null;
        
        allow delete: if request.auth != null && isAdminSafe();
      }
    }

    match /service_reports/{reportId} {
      allow create: if request.auth != null && isAdminSafe()
                    && hasAcceptableFieldCount(request.resource.data, 20);
      
      allow read: if request.auth != null 
                  && (isAdminSafe() 
                      || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                         && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tde'
                             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cbre')));
      
      allow update: if request.auth != null && isAdminSafe();
      
      allow delete: if request.auth != null && isAdminSafe();

      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && isAdminSafe();
      }
    }

    match /corrective_reports/{reportId} {
      allow create: if request.auth != null && isStandbyEngineer()
                    && hasAcceptableFieldCount(request.resource.data, 20);
      
      allow read: if request.auth != null;
      
      allow delete: if request.auth != null 
                    && (isAdminSafe() || (isStandbyEngineer() && resource.data.reportedBy == request.auth.uid));
    }
    
    match /service_report_templates/{templateId} {
      allow write: if request.auth != null && isAdminSafe()
                   && hasAcceptableFieldCount(request.resource.data, 30);
      
      allow read: if request.auth != null;
    }
    
    match /hse/{reportId} {
      allow create: if request.auth != null 
                    && (isHSE() || isAdminSafe() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll(['aktivitas', 'lokasi', 'createdAt', 'authorEmail'])
                    && request.resource.data.authorEmail == request.auth.token.email
                    && hasAcceptableFieldCount(request.resource.data, 30)
                    && isValidString(request.resource.data.aktivitas, 500)
                    && isValidString(request.resource.data.lokasi, 500)
                    && isValidString(request.resource.data.authorEmail, 200);
      
      allow read: if true;
      
      allow update: if request.auth != null 
                    && (isAdminSafe() 
                        || (isHSE() && resource.data.authorEmail == request.auth.token.email)
                        || (isPrivilegedRole() && resource.data.authorEmail == request.auth.token.email))
                    && hasAcceptableFieldCount(request.resource.data, 30);
      
      allow delete: if request.auth != null 
                    && (isAdminSafe() 
                        || (isHSE() && resource.data.authorEmail == request.auth.token.email));

      match /photos/{photoId} {
        allow read: if true;
        allow create: if request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 8)
                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/hse/$(reportId)).data.authorEmail == request.auth.token.email || isAdminSafe() || isPrivilegedRole());
      }
    }

    match /{division}/{fileId} {
      allow create: if request.auth != null 
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminSafe() || isDivision(division))
                    && request.resource.data.keys().hasAll(['fileName', 'fileSize', 'fileType', 'uploadedBy', 'uploadedAt'])
                    && hasAcceptableFieldCount(request.resource.data, 20);
      
      allow read: if request.auth != null 
                  && division in ['pmo', 'sales', 'presales', 'purchasing']
                  && (isAdminSafe() || isDivision(division) || isDirector());
      
      allow delete: if request.auth != null && isAdminSafe();

      match /chunks/{chunkId} {
        allow create: if request.auth != null 
                      && division in ['pmo', 'sales', 'presales', 'purchasing']
                      && (isAdminSafe() || isDivision(division))
                      && hasAcceptableFieldCount(request.resource.data, 10);
        
        allow read: if request.auth != null 
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminSafe() || isDivision(division) || isDirector());
        
        allow delete: if request.auth != null && isAdminSafe();
      }
    }

    match /findings/{findingId} {
      allow create: if request.auth != null 
                    && (isAdminSafe() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 20)
                    && request.resource.data.keys().hasAll(['partName', 'partNumber', 'quantity', 'findingDate', 'photos', 'createdBy', 'createdByEmail', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdByEmail == request.auth.token.email
                    && isValidString(request.resource.data.partName, 500)
                    && isValidString(request.resource.data.partNumber, 200);
      
      allow read: if request.auth != null 
                  && (resource.data.createdBy == request.auth.uid 
                      || isPrivilegedRole());
      
      allow delete: if request.auth != null 
                    && (isAdminSafe() 
                        || resource.data.createdBy == request.auth.uid);
    }

    match /maintenance_progress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                    && (isAdminSafe() 
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'site_manager');
    }

    match /inventory_borrowings/{docId} {
      allow create: if request.auth != null 
                    && (isStandbyEngineer() || isAdminSafe())
                    && hasAcceptableFieldCount(request.resource.data, 15)
                    && request.resource.data.engineerEmail == request.auth.token.email;
      
      allow read: if request.auth != null;
      
      allow update: if request.auth != null 
                    && (isAdminSafe() || (isStandbyEngineer() && resource.data.engineerEmail == request.auth.token.email))
                    && hasAcceptableFieldCount(request.resource.data, 20);
      
      allow delete: if request.auth != null && isAdminSafe();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
