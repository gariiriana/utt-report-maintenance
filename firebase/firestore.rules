rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The signed claim permits Drafter authentication even during profile read quota errors.
    function isDrafter() {
      return request.auth != null && (
        request.auth.token.get('role', '') == 'drafter'
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'drafter')
      );
    }

    function canManageBOQ() {
      return isDrafter() || isAdminOrQcDme();
    }

    // Text, revision and audit fields shared by baseline and custom items.
    // `deleted` is a soft-delete tombstone; documents are never physically removed.
    function validBOQCommon(data) {
      return isValidString(data.ciName, 500) && data.ciName.size() > 0
        && isValidString(data.ciDescription, 2000) && isValidString(data.capacity, 500)
        && (!('serialNumber' in data.keys()) || isValidString(data.serialNumber, 500))
        && (!('productionYear' in data.keys()) || isValidString(data.productionYear, 20))
        && (!('manufacturer' in data.keys()) || isValidString(data.manufacturer, 500))
        && (!('assetId' in data.keys()) || isValidString(data.assetId, 500))
        && (!('tag' in data.keys()) || isValidString(data.tag, 500))
        && (!('model' in data.keys()) || isValidString(data.model, 500))
        && (!('deleted' in data.keys()) || data.deleted is bool)
        && (!('updatedByName' in data.keys()) || isValidString(data.updatedByName, 200))
        && data.revision is int && data.revision > 0
        && data.sourceRow is int
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    // v1: "BOQ PER RUANGAN" workbook (ROOM / NO ROOM sheets). v2: per-equipment BOQ workbook,
    // where sourceSheet is the sheet key (e.g. "lv-panel") and the ID is derived from it and the source row.
    function validBOQItem(itemId, data) {
      return data.keys().hasAll(['ciName', 'ciDescription', 'capacity', 'revision', 'sourceSheet', 'sourceRow', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['ciName', 'ciDescription', 'capacity', 'serialNumber', 'productionYear', 'manufacturer', 'assetId', 'tag', 'model', 'deleted', 'revision', 'sourceSheet', 'sourceRow', 'updatedBy', 'updatedByName', 'updatedAt'])
        && validBOQCommon(data)
        && ((data.sourceSheet == 'ROOM' && data.sourceRow >= 3 && data.sourceRow <= 1738 && itemId == 'room-v1-room-' + string(data.sourceRow))
          || (data.sourceSheet == 'NO ROOM' && data.sourceRow >= 2 && data.sourceRow <= 680 && itemId == 'room-v1-no-room-' + string(data.sourceRow))
          || (data.sourceSheet is string && data.sourceSheet.size() <= 60 && data.sourceSheet.matches('[a-z0-9]+(-[a-z0-9]+)*')
            && data.sourceSheet != 'custom' && data.sourceRow >= 1 && data.sourceRow <= 5000
            && itemId == 'boq-v2-' + data.sourceSheet + '-' + string(data.sourceRow)));
    }

    function isBOQItemId(itemId) {
      return itemId.matches('room-v1-((room|no-room)-[0-9]+|custom-[0-9a-f]{32})')
        || itemId.matches('boq-v2-([a-z0-9]+(-[a-z0-9]+)*-[0-9]+|custom-[0-9a-f]{32})');
    }

    // Items added by a drafter: not part of the bundled workbook, so they carry their own room/class placement.
    function validBOQCustomItem(itemId, data) {
      return data.keys().hasAll(['ciName', 'ciDescription', 'capacity', 'revision', 'sourceSheet', 'sourceRow', 'updatedBy', 'updatedAt', 'custom', 'room', 'classId', 'floor'])
        && data.keys().hasOnly(['ciName', 'ciDescription', 'capacity', 'serialNumber', 'productionYear', 'manufacturer', 'assetId', 'tag', 'model', 'deleted', 'revision', 'sourceSheet', 'sourceRow', 'updatedBy', 'updatedByName', 'updatedAt', 'custom', 'room', 'classId', 'floor', 'category'])
        && validBOQCommon(data)
        && (itemId.matches('room-v1-custom-[0-9a-f]{32}') || itemId.matches('boq-v2-custom-[0-9a-f]{32}'))
        && (!('category' in data.keys()) || isValidString(data.category, 100))
        && data.custom == true && data.sourceSheet == 'CUSTOM' && data.sourceRow == 0
        && isValidString(data.room, 200) && data.room.size() > 0
        && isValidString(data.classId, 200) && data.classId.size() > 0
        && isValidString(data.floor, 50);
    }

    match /boq_items/{itemId} {
      allow read: if canManageBOQ();
      allow create: if canManageBOQ()
        && (validBOQItem(itemId, request.resource.data) || validBOQCustomItem(itemId, request.resource.data))
        && request.resource.data.revision == 1;
      allow update: if canManageBOQ()
        && (validBOQItem(itemId, request.resource.data)
          || (validBOQCustomItem(itemId, request.resource.data)
            && request.resource.data.room == resource.data.room
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.floor == resource.data.floor
            && request.resource.data.get('category', '') == resource.data.get('category', '')))
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.sourceSheet == resource.data.sourceSheet
        && request.resource.data.sourceRow == resource.data.sourceRow;
      allow delete: if false;

      // Photos can belong to a baseline item before its first text edit.
      match /photos/{photoId} {
        allow read: if canManageBOQ();
        allow create: if canManageBOQ()
          && isBOQItemId(itemId)
          && photoId.matches('[0-9a-f]{64}')
          && request.resource.data.keys().hasAll(['path', 'storageType', 'totalChunks', 'name', 'size', 'contentType', 'uploadedBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['path', 'storageType', 'totalChunks', 'name', 'size', 'contentType', 'uploadedBy', 'createdAt', 'thumb'])
          && (!('thumb' in request.resource.data.keys()) || (request.resource.data.thumb is bytes && request.resource.data.thumb.size() <= 150 * 1024))
          && request.resource.data.path == 'boq_items/' + itemId + '/photos/' + photoId
          && request.resource.data.storageType == 'firestore-bytes'
          && request.resource.data.totalChunks is int && request.resource.data.totalChunks >= 1 && request.resource.data.totalChunks <= 48
          && isValidString(request.resource.data.name, 500)
          && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10 * 1024 * 1024
          && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp']
          && request.resource.data.uploadedBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if canManageBOQ()
          && isBOQItemId(itemId)
          && photoId.matches('[0-9a-f]{64}')
          && request.resource.data.keys().hasAll(['path', 'storageType', 'totalChunks', 'name', 'size', 'contentType', 'uploadedBy', 'createdAt'])
          && request.resource.data.keys().hasOnly(['path', 'storageType', 'totalChunks', 'name', 'size', 'contentType', 'uploadedBy', 'createdAt', 'thumb'])
          && (!('thumb' in request.resource.data.keys()) || (request.resource.data.thumb is bytes && request.resource.data.thumb.size() <= 150 * 1024))
          && request.resource.data.path == resource.data.path
          && request.resource.data.storageType == 'firestore-bytes'
          && request.resource.data.totalChunks == resource.data.totalChunks
          && request.resource.data.size == resource.data.size
          && request.resource.data.contentType == resource.data.contentType
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if canManageBOQ();

        match /chunks/{chunkId} {
          allow read: if canManageBOQ();
          allow create, update: if canManageBOQ()
            && isBOQItemId(itemId)
            && photoId.matches('[0-9a-f]{64}')
            && chunkId.matches('[0-9]{5}')
            && request.resource.data.keys().hasAll(['index', 'data', 'createdAt'])
            && request.resource.data.keys().hasOnly(['index', 'data', 'createdAt'])
            && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < 48
            && request.resource.data.data is bytes && request.resource.data.data.size() <= 900 * 1024
            && request.resource.data.createdAt == request.time;
          allow delete: if canManageBOQ();
        }
      }
    }

    // Export BOQ lists photos across items. Scoped by storageType so other `photos` collections stay closed to drafters.
    match /{path=**}/photos/{photoId} {
      allow list: if canManageBOQ() && resource.data.storageType == 'firestore-bytes';
    }

    function getEmail() {
      return request.auth.token.get('email', '');
    }

    function isAdminSafe() {
      return request.auth != null
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isQcDmeSafe() {
      return request.auth != null
             && (
               getEmail() == 'qcdme@dme.com' ||
               (request.auth.uid != null
                && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'qc_dme')
             );
    }

    function isStrictQcDme() {
      return request.auth != null && getEmail().lower() == 'qcdme@dme.com';
    }

    function isAdminOrQcDme() {
      return isAdminSafe() || isQcDmeSafe();
    }

    function isStandbyEngineer() {
      return request.auth != null
             && (getEmail().lower() == 'dwimitra@co.id'
                 || (request.auth.uid != null
                     && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                     && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'standby_engineer'));
    }

    function isHSE() {
      return request.auth != null
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hse';
    }

    function isDirector() {
      return request.auth != null
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dirut' ||
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'direksiSDM' ||
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DireksiKeuangan');
    }

    function isEngineer() {
      return request.auth != null
             && request.auth.uid != null
             && (
               (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['engineer', 'standby_engineer', 'tde', 'cbre', 'Engineer_K2', 'engineer_k2']))
               || (getEmail().matches('(?i).*(engineer|standby|tde|cbre|k2|ahu|acp|ups|pac|chiller|me|genset|pln|trafo|cubicle|bms|fire|cctv|dme).*'))
             );
    }

    function isPrivilegedRole() {
       return request.auth != null
              && (
                getEmail() == 'qcdme@dme.com' ||
                (request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'qc_dme', 'manager', 'site_manager', 'hse', 'dirut', 'direksiSDM', 'DireksiKeuangan'])
              );
    }

    function isDME() {
      return request.auth != null
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DME', 'dme', 'site_manager_dme'];
    }

    function isSiteManagerDME() {
      return request.auth != null
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['site_manager_dme', 'DME', 'dme'];
    }

    function isDivision(div) {
      return request.auth != null
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == div;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidPhotoData(data) {
      return data is string && data.size() <= 2800000;
    }

    function hasAcceptableFieldCount(data, maxFields) {
      return data.keys().size() <= maxFields;
    }

    match /users/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['role'])
                        || request.resource.data.role in ['engineer', 'standby_engineer', 'Engineer_K2']);

      allow get: if request.auth != null && (!isDrafter() || request.auth.uid == userId);
      allow list: if request.auth != null && !isDrafter();

      allow update: if request.auth != null
                    && (
                      isAdminOrQcDme()
                      || (
                        request.auth.uid == userId
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                      )
                    );

      allow delete: if request.auth != null && isAdminOrQcDme();
    }

    match /excel_documents/{docId} {
      allow create: if !isDrafter() && (request.auth != null
                    && (getEmail() != '' || request.resource.data.createdBy == getEmail() || isEngineer() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll([
                      'fileName',
                      'maintenanceName',
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 60)
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.maintenanceName, 500)
                    && isValidString(request.resource.data.createdBy, 200));

      allow read: if !isDrafter() && (request.auth != null);

      allow delete: if !isDrafter() && (isStrictQcDme());

      allow update: if !isDrafter() && (request.auth != null
                    && (getEmail() != '' || resource.data.createdBy == getEmail() || isPrivilegedRole() || isEngineer() || isDME())
                    && hasAcceptableFieldCount(request.resource.data, 60));

      match /photos/{photoId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 10));
        allow update, delete: if !isDrafter() && (request.auth != null);
      }
    }

    match /pdf_documents/{docId} {
      allow create: if !isDrafter() && (request.auth != null
                    && (getEmail() != '' || request.resource.data.createdBy == getEmail() || isEngineer() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll([
                      'fileName',
                      'maintenanceName',
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 60)
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.maintenanceName, 500)
                    && isValidString(request.resource.data.createdBy, 200));

      allow read: if !isDrafter() && (request.auth != null);

      allow delete: if !isDrafter() && (isStrictQcDme());

      allow update: if !isDrafter() && (request.auth != null
                    && (getEmail() != '' || resource.data.createdBy == getEmail() || isPrivilegedRole() || isEngineer() || isDME())
                    && hasAcceptableFieldCount(request.resource.data, 60));

      match /photos/{photoId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 10));
        allow update, delete: if !isDrafter() && (request.auth != null);
      }
    }

    match /files/{fileId} {
      allow create: if request.auth != null
                    && (isDrafter() || !isStandbyEngineer())
                    && (isDrafter() || isAdminOrQcDme() || isEngineer() || isPrivilegedRole() || isDME() || request.auth.uid != null)
                    && request.resource.data.keys().hasAll([
                      'fileName',
                      'fileSize',
                      'fileType',
                      'category',
                      'uploadedBy',
                      'uploadedByEmail',
                      'uploadedAt'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 25)
                    && request.resource.data.uploadedBy == request.auth.uid
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.fileType, 100);

      allow read: if request.auth != null;

      allow update: if request.auth != null
                    && (!isDrafter() || resource.data.uploadedBy == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'deleteRequested', 'deleteRequestedBy', 'deleteRequestedRole',
                          'deleteRequestedTo', 'deleteReason', 'deleteRequestedAt'
                        ]))
        // dwimitra@co.id dihitung standby oleh isStandbyEngineer(), tapi UI tetap memberinya tombol
        // Pengajuan Hapus. Izinkan khusus field pengajuan hapus saja.
        && (isDrafter() || !isStandbyEngineer()
            || (getEmail().lower() == 'dwimitra@co.id'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'deleteRequested', 'deleteRequestedBy', 'deleteRequestedRole',
                  'deleteRequestedTo', 'deleteReason', 'deleteRequestedAt'
                ])))
        && (
          (resource.data.uploadedBy == request.auth.uid
            && resource.data.status == 'uploading'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedAt']))
          ||
          (!isDrafter() && isAdminOrQcDme())
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'deleteRequested',
                          'deleteRequestedBy',
                          'deleteRequestedRole',
                          'deleteRequestedTo',
                          'deleteReason',
                          'deleteRequestedAt'
                        ])
                    );

      allow delete: if isStrictQcDme();

        match /chunks/{chunkId} {
          allow create: if request.auth != null
                      && (!isDrafter() || get(/databases/$(database)/documents/files/$(fileId)).data.uploadedBy == request.auth.uid)
                      && (isDrafter() || !isStandbyEngineer())
                      && (isDrafter() || isAdminOrQcDme() || isEngineer() || isPrivilegedRole() || isDME() || request.auth.uid != null)
                      && hasAcceptableFieldCount(request.resource.data, 10);

          // Idempotent retries may rewrite the same index after an acknowledged-write timeout.
          allow update: if request.auth != null
                        && get(/databases/$(database)/documents/files/$(fileId)).data.uploadedBy == request.auth.uid
                        && (isDrafter() || !isStandbyEngineer())
                        && hasAcceptableFieldCount(request.resource.data, 10)
                        && request.resource.data.index == resource.data.index;

        allow read: if request.auth != null;

        allow delete: if isStrictQcDme();
      }
    }

    match /service_reports/{reportId} {
      allow create: if !isDrafter() && (request.auth != null && isAdminOrQcDme()
                    && hasAcceptableFieldCount(request.resource.data, 20));

      allow read: if !isDrafter() && (request.auth != null
                  && (isAdminOrQcDme()
                      || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                         && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tde'
                             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cbre'))));

      allow update: if !isDrafter() && (request.auth != null && isAdminOrQcDme());

      allow delete: if !isDrafter() && (request.auth != null && isAdminOrQcDme());

      match /chunks/{chunkId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create, delete: if !isDrafter() && (request.auth != null && isAdminOrQcDme());
      }
    }

    match /service_report_templates/{templateId} {
      allow write: if !isDrafter() && (request.auth != null && isAdminOrQcDme()
                   && hasAcceptableFieldCount(request.resource.data, 30));

      allow read: if !isDrafter() && (request.auth != null);
    }

    match /hse/{reportId} {
      allow create: if !isDrafter() && (request.auth != null
                    && (isHSE() || isAdminOrQcDme() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll(['aktivitas', 'lokasi', 'createdAt', 'authorEmail'])
                    && request.resource.data.authorEmail == getEmail()
                    && hasAcceptableFieldCount(request.resource.data, 30)
                    && isValidString(request.resource.data.aktivitas, 500)
                    && isValidString(request.resource.data.lokasi, 500)
                    && isValidString(request.resource.data.authorEmail, 200));

      allow get: if true;
      allow list: if !isDrafter() && (request.auth != null);

      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme()
                        || (isHSE() && resource.data.authorEmail == getEmail())
                        || (isPrivilegedRole() && resource.data.authorEmail == getEmail()))
                    && hasAcceptableFieldCount(request.resource.data, 30));

      allow delete: if !isDrafter() && (isStrictQcDme());

      match /photos/{photoId} {
        allow get: if true;
        allow list: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 8)
                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl)));
        allow update, delete: if !isDrafter() && (request.auth != null
                              && (get(/databases/$(database)/documents/hse/$(reportId)).data.authorEmail == getEmail() || isAdminOrQcDme() || isPrivilegedRole()));
      }
    }

    match /{division}/{fileId} {
      allow create: if !isDrafter() && (request.auth != null
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminOrQcDme() || isDivision(division) || isPrivilegedRole())
                    && request.resource.data.keys().hasAll(['fileName', 'fileSize', 'fileType', 'uploadedBy', 'uploadedAt'])
                    && hasAcceptableFieldCount(request.resource.data, 20));

      allow read: if !isDrafter() && (request.auth != null
                  && division in ['pmo', 'sales', 'presales', 'purchasing']
                  && (isAdminOrQcDme() || isDivision(division) || isDirector() || isPrivilegedRole()));

      allow update: if !isDrafter() && (request.auth != null
                      && division in ['pmo', 'sales', 'presales', 'purchasing']
                      && (
                        isAdminOrQcDme()
                        || (resource.data.uploadedBy == request.auth.uid
                            && resource.data.status == 'uploading'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadedAt']))
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'deleteRequested',
                          'deleteRequestedBy',
                          'deleteRequestedRole',
                          'deleteRequestedTo',
                          'deleteReason',
                          'deleteRequestedAt'
                        ])
                    ));

      allow delete: if !isDrafter() && (isStrictQcDme());

        match /chunks/{chunkId} {
          allow create: if !isDrafter() && (request.auth != null
                      && division in ['pmo', 'sales', 'presales', 'purchasing']
                      && (isAdminOrQcDme() || isDivision(division) || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10));

          allow update: if !isDrafter() && (request.auth != null
                        && division in ['pmo', 'sales', 'presales', 'purchasing']
                        && get(/databases/$(database)/documents/$(division)/$(fileId)).data.uploadedBy == request.auth.uid
                        && (isAdminOrQcDme() || isDivision(division) || isPrivilegedRole())
                        && hasAcceptableFieldCount(request.resource.data, 10)
                        && request.resource.data.index == resource.data.index);

        allow read: if !isDrafter() && (request.auth != null
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminOrQcDme() || isDivision(division) || isDirector() || isPrivilegedRole()));

        allow delete: if !isDrafter() && (isStrictQcDme());
      }
    }

    match /findings/{findingId} {
      allow create: if !isDrafter() && (request.auth != null
                    && (getEmail() != '' || isAdminOrQcDme() || isEngineer() || isPrivilegedRole() || isDME() || isStandbyEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 30));

      allow read: if !isDrafter() && (request.auth != null);

      allow update: if !isDrafter() && (request.auth != null
                    && (getEmail() != '' || isAdminOrQcDme() || isEngineer() || isPrivilegedRole() || isDME() || isStandbyEngineer() || resource.data.createdBy == request.auth.uid)
                    && hasAcceptableFieldCount(request.resource.data, 30));

      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    match /maintenance_progress/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow write: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme()
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'site_manager'));
    }

    match /system_status/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow write: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isPrivilegedRole() || isStandbyEngineer() || getEmail().matches('.*dwimitra.*')));

      match /logs/{logId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow write: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isPrivilegedRole() || isStandbyEngineer() || getEmail().matches('.*dwimitra.*')));
      }
    }

    match /mop_workflows/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 25));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 25));
      allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole()));

      match /draft_chunks/{chunkId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10));
        allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole()));
      }

      match /ocs_approved_chunks/{chunkId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10));
        allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole()));
      }

      match /tde_approved_chunks/{chunkId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10));
        allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isPrivilegedRole()));
      }
    }

    match /ptw_records/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 15));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 15));
      allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isEngineer()));

      match /chunks/{chunkId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create: if !isDrafter() && (request.auth != null
                      && (isAdminOrQcDme() || isEngineer())
                      && hasAcceptableFieldCount(request.resource.data, 10));
        allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isEngineer()));
      }
    }

    match /absen_tbm/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow write: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isPrivilegedRole()));
    }

    match /absen_induction/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isHSE() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 10)
                    && (
                      (
                        request.resource.data.keys().hasAll(['tanggal', 'nama', 'createdAt'])
                        && isValidString(request.resource.data.nama, 300)
                      )
                      ||
                      (
                        request.resource.data.keys().hasAll(['tanggal', 'isDocumentation', 'photos', 'createdAt'])
                        && request.resource.data.isDocumentation == true
                      )
                    )
                    && isValidString(request.resource.data.tanggal, 20));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isHSE() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 10));
      allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isHSE()));
    }

    match /absen_induction_chunks/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create, update: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isHSE() || isPrivilegedRole()));
      allow delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isHSE()));
    }

    match /notifications/{docId} {
      // Drafter may submit file deletion requests to QC, without reading other notifications.
      allow create: if isDrafter()
        && request.resource.data.keys().hasOnly(['title', 'fileName', 'category', 'fileId', 'uploadedBy', 'targetEmail', 'targetTab', 'searchQuery', 'reason', 'createdAt'])
        && request.resource.data.targetEmail == 'qcdme@dme.com' && request.resource.data.targetTab == 'files'
        && request.resource.data.uploadedBy == getEmail()
        && isValidString(request.resource.data.reason, 2000)
        && request.resource.data.createdAt == request.time;
      allow read: if !isDrafter() && (request.auth != null);
      allow create, update, delete: if !isDrafter() && (request.auth != null);
    }

    match /uploaded_files/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create, update, delete: if !isDrafter() && (request.auth != null);
    }

    match /sparepart_logs/{logId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME())
                    && hasAcceptableFieldCount(request.resource.data, 20));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME() || resource.data.createdBy == request.auth.uid)
                    && hasAcceptableFieldCount(request.resource.data, 20));
      allow delete: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isPrivilegedRole() || resource.data.createdBy == request.auth.uid || isStandbyEngineer()));
    }

    match /corrective_reports/{reportId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME()));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME() || resource.data.reportedBy == request.auth.uid || resource.data.createdBy == request.auth.uid));
      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    // ============================================================================
    // Koleksi: predictive_reports — Laporan Predictive Maintenance (PdM AI Agent)
    // Akses: Admin, QC DME, Engineer, Standby Engineer, DME & Privileged can CRUD
    // ============================================================================
    match /predictive_reports/{reportId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME()));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME() || resource.data.createdBy == getEmail() || resource.data.createdBy == request.auth.uid));
      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    // ============================================================================
    // Koleksi: periodic_predictive_reports — Laporan PdM Periodik (Bulanan & Tahunan)
    // Akses: Admin, QC DME, Engineer, Standby Engineer, DME & Privileged can CRUD
    // ============================================================================
    match /periodic_predictive_reports/{reportId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME()));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME() || resource.data.createdBy == getEmail() || resource.data.createdBy == request.auth.uid));
      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    match /standby_kpi_inputs/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create, update, delete: if !isDrafter() && (request.auth != null && (isAdminOrQcDme() || isStandbyEngineer() || isPrivilegedRole() || isEngineer() || isDME()));
    }

    // ============================================================================
    // Koleksi: hse_findings — Data Temuan Keselamatan Kerja (HSE Findings)
    // Akses: HSE Officer, Admin, Engineer, Standby & Privileged bisa CRUD. Auth users bisa read.
    // ============================================================================
    match /hse_findings/{findingId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isHSE() || isPrivilegedRole() || isEngineer() || isStandbyEngineer() || isDME())
                    && request.resource.data.keys().hasAll([
                      'title',
                      'location',
                      'severity',
                      'status',
                      'reportedBy',
                      'findingDate',
                      'beforePhoto',
                      'createdAt'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 30)
                    && isValidString(request.resource.data.title, 500)
                    && isValidString(request.resource.data.location, 500)
                    && request.resource.data.status in ['open', 'close']);
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isHSE() || isPrivilegedRole() || isEngineer() || isStandbyEngineer() || isDME()
                        || resource.data.reportedBy == getEmail())
                    && hasAcceptableFieldCount(request.resource.data, 30)
                    && request.resource.data.status in ['open', 'close']);
      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    // ============================================================================
    // Koleksi: berita_acara — Arsip Dokumen Berita Acara Maintenance DOCX
    // Akses: Admin, DME, Engineer, Standby & Privileged can CRUD. Auth users can read.
    // ============================================================================
    match /berita_acara/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isDME() || isSiteManagerDME() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || request.auth.uid != null));
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isDME() || isSiteManagerDME() || isEngineer() || isPrivilegedRole() || resource.data.createdBy == getEmail()));
      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    // ============================================================================
    // Koleksi: monthly_reports — Data & Draft Laporan Bulanan (Monthly Report)
    // Akses: Admin, DME, Site Manager, Engineer, Standby dapat CRUD. Auth users read.
    // ============================================================================
    match /monthly_reports/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null);
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || resource.data.createdBy == getEmail() || request.resource.data.createdBy == getEmail()));
      allow delete: if !isDrafter() && (isStrictQcDme());

      // Subkoleksi: assets — gambar arsip (foto RCA, photo log) dipisah per dokumen
      // supaya dokumen utama laporan tidak melewati batas 1 MiB Firestore.
      match /assets/{assetId} {
        allow read: if !isDrafter() && (request.auth != null);
        allow create, update: if !isDrafter() && (request.auth != null)
                      && request.resource.data.keys().hasOnly(['data', 'createdAt'])
                      && request.resource.data.data is string
                      && request.resource.data.data.size() <= 1000000;
        allow delete: if !isDrafter() && (request.auth != null);
      }
    }

    // ============================================================================
    // Koleksi: sop_eop_documents — Arsip Dokumen SOP & EOP Standar Corporate
    // Akses: Admin, DME, Site Manager, Engineer, Standby dapat CRUD. Auth users read.
    // ============================================================================
    match /sop_eop_documents/{docId} {
      allow read: if !isDrafter() && (request.auth != null);
      allow create: if !isDrafter() && (request.auth != null);
      allow update: if !isDrafter() && (request.auth != null
                    && (isAdminOrQcDme() || isSiteManagerDME() || isDME() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || resource.data.createdBy == getEmail() || request.resource.data.createdBy == getEmail()));
      allow delete: if !isDrafter() && (isStrictQcDme());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
