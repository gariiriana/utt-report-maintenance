rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getEmail() {
      return request.auth.token.get('email', '');
    }

    function isAdminSafe() {
      return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
               )
               ||
               (
                 request.auth.token != null
                 && getEmail().matches('.*admin.*')
               )
             );
    }

    function isStandbyEngineer() {
      return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'standby_engineer'
               )
               ||
               (
                 request.auth.token != null
                 && (getEmail().matches('.*standby.*') || getEmail().matches('.*dwimitra.*') || getEmail().matches('.*utt.*') || getEmail().matches('.*gari.*') || getEmail().matches('.*agil.*'))
               )
             );
    }

    function isHSE() {
      return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hse'
               )
               ||
               (
                 request.auth.token != null
                 && getEmail().matches('.*hse.*')
               )
             );
    }

    function isDirector() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dirut' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'direksiSDM' || 
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DireksiKeuangan');
    }

    function isEngineer() {
      return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['engineer', 'standby_engineer', 'tde', 'cbre'])
               )
               ||
               (
                 request.auth.token != null
                 && (getEmail().matches('.*standby.*') || getEmail().matches('.*engineer.*') || getEmail().matches('.*dwimitra.*') || getEmail().matches('.*fss.*') || getEmail().matches('.*utt.*') || getEmail().matches('.*ats.*') || getEmail().matches('.*pju.*') || getEmail().matches('.*fcu.*') || getEmail().matches('.*pdu.*') || getEmail().matches('.*vrv.*') || getEmail().matches('.*ac.*') || getEmail().matches('.*generator.*') || getEmail().matches('.*trafo.*') || getEmail().matches('.*gari.*') || getEmail().matches('.*agil.*'))
               )
             );
    }

    function isPrivilegedRole() {
       return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'site_manager', 'hse', 'dirut', 'direksiSDM', 'DireksiKeuangan']
               )
               ||
               (
                 request.auth.token != null
                 && (
                   getEmail().matches('.*admin.*')
                   || getEmail().matches('.*manager.*')
                   || getEmail().matches('.*sitemanager.*')
                   || getEmail().matches('.*site_manager.*')
                   || getEmail().matches('.*hse.*')
                   || getEmail().matches('.*dirut.*')
                   || getEmail().matches('.*direksisdm.*')
                   || getEmail().matches('.*direksikeuangan.*')
                 )
               )
             );
    }

    function isDME() {
      return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DME', 'dme', 'site_manager_dme']
               )
               ||
               (
                 request.auth.token != null
                 && (getEmail().matches('.*dme.*') || getEmail().matches('.*sitemanagerdme.*') || getEmail().matches('.*site_manager_dme.*'))
               )
             );
    }

    function isSiteManagerDME() {
      return request.auth != null 
             && (
               (
                 request.auth.uid != null
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['site_manager_dme', 'DME', 'dme']
               )
               ||
               (
                 request.auth.token != null
                 && (getEmail().matches('.*sitemanagerdme.*') || getEmail().matches('.*site_manager_dme.*') || getEmail().matches('.*dme.*'))
               )
             );
    }

    function isDivision(div) {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == div;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidPhotoData(data) {
      return data is string && data.size() <= 2800000;
    }
    
    function hasAcceptableFieldCount(data, maxFields) {
      return data.keys().size() <= maxFields;
    }

    match /users/{userId} {
      allow create: if request.auth != null 
                    && request.auth.uid == userId;
      
      allow read: if request.auth != null;
      
      allow update: if request.auth != null 
                    && (
                      isAdminSafe()
                      || (
                        request.auth.uid == userId
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
                      )
                    );
      
      allow delete: if request.auth != null && isAdminSafe();
    }
    
    match /excel_documents/{docId} {
      allow create: if request.auth != null 
                    && (request.resource.data.createdBy == getEmail() || isEngineer() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll([
                      'fileName', 
                      'maintenanceName', 
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 25)
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.maintenanceName, 500)
                    && isValidString(request.resource.data.createdBy, 200);
      
      allow read: if request.auth != null 
                  && (resource.data.createdBy == getEmail() || isPrivilegedRole() || isEngineer() || isDME());
      
      allow delete: if request.auth != null && (isAdminSafe() || resource.data.createdBy == getEmail());
      
      allow update: if request.auth != null 
                    && (resource.data.createdBy == getEmail() || isPrivilegedRole() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 25);

      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 10);
        allow update, delete: if request.auth != null;
      }
    }
    
    match /pdf_documents/{docId} {
      allow create: if request.auth != null 
                    && (request.resource.data.createdBy == getEmail() || isEngineer() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll([
                      'fileName', 
                      'maintenanceName', 
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 25)
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.maintenanceName, 500)
                    && isValidString(request.resource.data.createdBy, 200);
      
      allow read: if request.auth != null 
                  && (resource.data.createdBy == getEmail() || isPrivilegedRole() || isEngineer() || isDME());
      
      allow delete: if request.auth != null && (isAdminSafe() || resource.data.createdBy == getEmail());
      
      allow update: if request.auth != null 
                    && (resource.data.createdBy == getEmail() || isPrivilegedRole() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 25);

      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 10);
        allow update, delete: if request.auth != null;
      }
    }
    
    match /files/{fileId} {
      allow create: if request.auth != null 
                    && (isAdminSafe() || isEngineer() || isPrivilegedRole() || isDME() || request.auth.uid != null)
                    && request.resource.data.keys().hasAll([
                      'fileName',
                      'fileSize',
                      'fileType',
                      'category',
                      'uploadedBy',
                      'uploadedByEmail',
                      'uploadedAt'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 20)
                    && request.resource.data.uploadedBy == request.auth.uid
                    && isValidString(request.resource.data.fileName, 500)
                    && isValidString(request.resource.data.fileType, 100);
      
      allow read: if request.auth != null;
      
      allow update: if request.auth != null 
                    && (isAdminSafe() || isEngineer() || isPrivilegedRole() || resource.data.uploadedBy == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      
      allow delete: if request.auth != null && (isAdminSafe() || isEngineer() || isPrivilegedRole() || resource.data.uploadedBy == request.auth.uid);

      match /chunks/{chunkId} {
        allow create: if request.auth != null 
                      && (isAdminSafe() || isEngineer() || isPrivilegedRole() || isDME() || request.auth.uid != null)
                      && hasAcceptableFieldCount(request.resource.data, 10);
        
        allow read: if request.auth != null;
        
        allow delete: if request.auth != null && (isAdminSafe() || isEngineer() || isPrivilegedRole() || resource.data.uploadedBy == request.auth.uid);
      }
    }

    match /service_reports/{reportId} {
      allow create: if request.auth != null && isAdminSafe()
                    && hasAcceptableFieldCount(request.resource.data, 20);
      
      allow read: if request.auth != null 
                  && (isAdminSafe() 
                      || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                         && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tde'
                             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cbre')));
      
      allow update: if request.auth != null && isAdminSafe();
      
      allow delete: if request.auth != null && isAdminSafe();

      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && isAdminSafe();
      }
    }
    
    match /service_report_templates/{templateId} {
      allow write: if request.auth != null && isAdminSafe()
                   && hasAcceptableFieldCount(request.resource.data, 30);
      
      allow read: if request.auth != null;
    }
    
    match /hse/{reportId} {
      allow create: if request.auth != null 
                    && (isHSE() || isAdminSafe() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll(['aktivitas', 'lokasi', 'createdAt', 'authorEmail'])
                    && request.resource.data.authorEmail == getEmail()
                    && hasAcceptableFieldCount(request.resource.data, 30)
                    && isValidString(request.resource.data.aktivitas, 500)
                    && isValidString(request.resource.data.lokasi, 500)
                    && isValidString(request.resource.data.authorEmail, 200);
      
      allow get: if true;
      allow list: if request.auth != null;
      
      allow update: if request.auth != null 
                    && (isAdminSafe() 
                        || (isHSE() && resource.data.authorEmail == getEmail())
                        || (isPrivilegedRole() && resource.data.authorEmail == getEmail()))
                    && hasAcceptableFieldCount(request.resource.data, 30);
      
      allow delete: if request.auth != null && isAdminSafe();

      match /photos/{photoId} {
        allow get: if true;
        allow list: if request.auth != null;
        allow create: if request.auth != null
                      && hasAcceptableFieldCount(request.resource.data, 8)
                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/hse/$(reportId)).data.authorEmail == getEmail() || isAdminSafe() || isPrivilegedRole());
      }
    }

    match /{division}/{fileId} {
      allow create: if request.auth != null 
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminSafe() || isDivision(division) || isPrivilegedRole())
                    && request.resource.data.keys().hasAll(['fileName', 'fileSize', 'fileType', 'uploadedBy', 'uploadedAt'])
                    && hasAcceptableFieldCount(request.resource.data, 20);
      
      allow read: if request.auth != null 
                  && division in ['pmo', 'sales', 'presales', 'purchasing']
                  && (isAdminSafe() || isDivision(division) || isDirector() || isPrivilegedRole());
      
      allow update: if request.auth != null
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminSafe() || isDivision(division) || resource.data.uploadedBy == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if request.auth != null && (isAdminSafe() || isDivision(division) || resource.data.uploadedBy == request.auth.uid);

      match /chunks/{chunkId} {
        allow create: if request.auth != null 
                      && division in ['pmo', 'sales', 'presales', 'purchasing']
                      && (isAdminSafe() || isDivision(division) || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10);
        
        allow read: if request.auth != null 
                    && division in ['pmo', 'sales', 'presales', 'purchasing']
                    && (isAdminSafe() || isDivision(division) || isDirector() || isPrivilegedRole());
        
        allow delete: if request.auth != null && (isAdminSafe() || isDivision(division) || resource.data.uploadedBy == request.auth.uid);
      }
    }

    match /findings/{findingId} {
      allow create: if request.auth != null 
                    && (isAdminSafe() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 20)
                    && request.resource.data.keys().hasAll(['partName', 'partNumber', 'quantity', 'findingDate', 'photos', 'createdBy', 'createdByEmail', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdByEmail == getEmail()
                    && isValidString(request.resource.data.partName, 500)
                    && isValidString(request.resource.data.partNumber, 200);
      
      allow read: if request.auth != null 
                  && (resource.data.createdBy == request.auth.uid 
                      || isPrivilegedRole()
                      || getEmail().matches('.*dwimitra.*'));
      
      allow delete: if request.auth != null 
                    && (isAdminSafe() 
                        || resource.data.createdBy == request.auth.uid);
    }

    match /maintenance_progress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                    && (isAdminSafe() 
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'site_manager');
    }

    match /system_status/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdminSafe();
    }

    match /mop_workflows/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 25);
      allow update: if request.auth != null
                    && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 25);
      allow delete: if request.auth != null && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole());

      match /draft_chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10);
        allow delete: if request.auth != null && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole());
      }

      match /ocs_approved_chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10);
        allow delete: if request.auth != null && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole());
      }

      match /tde_approved_chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole())
                      && hasAcceptableFieldCount(request.resource.data, 10);
        allow delete: if request.auth != null && (isAdminSafe() || isSiteManagerDME() || isDME() || isPrivilegedRole());
      }
    }

    match /ptw_records/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && (isAdminSafe() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 15);
      allow update: if request.auth != null
                    && (isAdminSafe() || isEngineer())
                    && hasAcceptableFieldCount(request.resource.data, 15);
      allow delete: if request.auth != null && (isAdminSafe() || isEngineer());

      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && (isAdminSafe() || isEngineer())
                      && hasAcceptableFieldCount(request.resource.data, 10);
        allow delete: if request.auth != null && (isAdminSafe() || isEngineer());
      }
    }

    match /absen_tbm/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdminSafe() || isPrivilegedRole());
    }

    match /absen_induction/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminSafe() || isHSE() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 10)
                    && (
                      (
                        request.resource.data.keys().hasAll(['tanggal', 'nama', 'createdAt'])
                        && isValidString(request.resource.data.nama, 300)
                      )
                      ||
                      (
                        request.resource.data.keys().hasAll(['tanggal', 'isDocumentation', 'photos', 'createdAt'])
                        && request.resource.data.isDocumentation == true
                      )
                    )
                    && isValidString(request.resource.data.tanggal, 20);
      allow update: if request.auth != null 
                    && (isAdminSafe() || isHSE() || isPrivilegedRole())
                    && hasAcceptableFieldCount(request.resource.data, 10);
      allow delete: if request.auth != null && (isAdminSafe() || isHSE());
    }

    match /absen_induction_chunks/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (isAdminSafe() || isHSE() || isPrivilegedRole());
      allow delete: if request.auth != null && (isAdminSafe() || isHSE());
    }

    match /notifications/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /uploaded_files/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /sparepart_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminSafe() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME())
                    && hasAcceptableFieldCount(request.resource.data, 20);
      allow update: if request.auth != null 
                    && (isAdminSafe() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME() || resource.data.createdBy == request.auth.uid)
                    && hasAcceptableFieldCount(request.resource.data, 20);
      allow delete: if request.auth != null 
                    && (isAdminSafe() || isPrivilegedRole() || resource.data.createdBy == request.auth.uid || isStandbyEngineer());
    }

    match /corrective_reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminSafe() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME());
      allow update: if request.auth != null 
                    && (isAdminSafe() || isEngineer() || isStandbyEngineer() || isPrivilegedRole() || isDME() || resource.data.reportedBy == request.auth.uid || resource.data.createdBy == request.auth.uid);
      allow delete: if request.auth != null 
                    && (isAdminSafe() || isPrivilegedRole() || resource.data.reportedBy == request.auth.uid || resource.data.createdBy == request.auth.uid || isStandbyEngineer());
    }

    match /standby_kpi_inputs/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (isAdminSafe() || isStandbyEngineer() || isPrivilegedRole() || isEngineer() || isDME());
    }

    // ============================================================================
    // Koleksi: hse_findings — Data Temuan Keselamatan Kerja (HSE Findings)
    // Akses: HSE Officer bisa CRUD. Admin & Privileged bisa CRUD. Auth users bisa read.
    // ============================================================================
    match /hse_findings/{findingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && (isAdminSafe() || isHSE() || isPrivilegedRole())
                    && request.resource.data.keys().hasAll([
                      'title',
                      'location', 
                      'category',
                      'severity',
                      'status',
                      'reportedBy',
                      'findingDate',
                      'beforePhoto',
                      'createdAt'
                    ])
                    && hasAcceptableFieldCount(request.resource.data, 25)
                    && isValidString(request.resource.data.title, 500)
                    && isValidString(request.resource.data.location, 500)
                    && request.resource.data.status in ['open', 'close'];
      allow update: if request.auth != null 
                    && (isAdminSafe() || isHSE() || isPrivilegedRole()
                        || resource.data.reportedBy == getEmail())
                    && hasAcceptableFieldCount(request.resource.data, 25)
                    && request.resource.data.status in ['open', 'close'];
      allow delete: if request.auth != null 
                    && (isAdminSafe() || isHSE() || isPrivilegedRole()
                        || resource.data.reportedBy == getEmail());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
