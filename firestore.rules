rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    // ✅ IMPROVED: Function to check if user is admin (BloomFilter safe)
    // Returns false if user document doesn't exist instead of throwing error
    function isAdmin() {
      return request.auth != null 
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // ✅ NEW: Safe admin check
    function isAdminSafe() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ✅ NEW: Standby Engineer check
    function isStandbyEngineer() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'standby_engineer';
    }

    // ✅ NEW: HSE Officer check
    function isHSE() {
      return request.auth != null 
             && request.auth.uid != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hse';
    }

    
    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasAll(['email', 'uid', 'role', 'companyType', 'createdAt'])
                    && (request.resource.data.role == 'admin' || request.resource.data.role == 'engineer' || request.resource.data.role == 'standby_engineer' || request.resource.data.role == 'tde' || request.resource.data.role == 'cbre' || request.resource.data.role == 'hse')
                    && (request.resource.data.companyType == 'neutra' || request.resource.data.companyType == 'bri');
      
      allow read: if request.auth != null 
                  && (request.auth.uid == userId || isAdminSafe() || isStandbyEngineer());
      
      allow update: if request.auth != null 
                    && (
                      (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyType']))
                      || isAdminSafe()
                    );
      
      allow delete: if request.auth != null && isAdminSafe();
    }
    
    // ============================================================
    // EXCEL_DOCUMENTS COLLECTION - Dokumen Excel yang di-export
    // ============================================================
    match /excel_documents/{docId} {
      // ✅ User yang login bisa create document
      allow create: if request.auth != null 
                    && request.resource.data.createdBy == request.auth.token.email
                    && request.resource.data.keys().hasAll([
                      'fileName', 
                      'maintenanceName', 
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'fileSize',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && (!request.resource.data.keys().hasAny(['specificDetail']) || request.resource.data.specificDetail is string);
      
      // ✅ FIX: Use isAdminSafe() to prevent BloomFilter error
      // User hanya bisa read dokumen milik mereka sendiri, ATAU admin bisa read semua
      allow read, delete: if request.auth != null 
                  && (resource.data.createdBy == request.auth.token.email 
                      || isAdminSafe());
      
      // ✅ Allow update if user is the creator or an admin
      allow update: if request.auth != null 
                    && (resource.data.createdBy == request.auth.token.email || isAdminSafe());

      // ✅ Subcollection untuk foto (Unlimited photos support)
      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // ✅ Allow update and delete if parent document owner or admin
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/excel_documents/$(docId)).data.createdBy == request.auth.token.email || isAdminSafe());
      }
    }
    
    // ============================================================
    // PDF_DOCUMENTS COLLECTION - Dokumen PDF yang di-export
    // ============================================================
    match /pdf_documents/{docId} {
      // ✅ User yang login bisa create document
      allow create: if request.auth != null 
                    && request.resource.data.createdBy == request.auth.token.email
                    && request.resource.data.keys().hasAll([
                      'fileName', 
                      'maintenanceName', 
                      'maintenanceTime',
                      'createdAt',
                      'createdBy',
                      'fileSize',
                      'totalPhotos',
                      'photosWithImage'
                    ])
                    && (!request.resource.data.keys().hasAny(['specificDetail']) || request.resource.data.specificDetail is string);
      
      // ✅ FIX: Inline admin check to prevent BloomFilter error
      allow read, delete: if request.auth != null 
                  && (resource.data.createdBy == request.auth.token.email 
                      || isAdminSafe());
      
      // ✅ Allow update if user is the creator or an admin
      allow update: if request.auth != null 
                    && (resource.data.createdBy == request.auth.token.email || isAdminSafe());

      // ✅ Subcollection untuk foto (Unlimited photos support)
      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // ✅ Allow update and delete if parent document owner or admin
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/pdf_documents/$(docId)).data.createdBy == request.auth.token.email || isAdminSafe());
      }
    }
    
    // ============================================================
    // FILES COLLECTION - File management (Sharded in Firestore)
    // ============================================================
    match /files/{fileId} {
      // ✅ Admin & Engineer bisa upload/create file metadata
      allow create: if request.auth != null 
                    && (isAdminSafe() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'engineer')
                    && request.resource.data.keys().hasAll([
                      'fileName',
                      'fileSize',
                      'fileType',
                      'category',
                      'uploadedBy',
                      'uploadedByEmail',
                      'uploadedAt'
                    ])
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.uploadedByEmail == request.auth.token.email;
      
      // ✅ Semua authenticated user bisa read files (admin & engineer)
      allow read: if request.auth != null;
      
      // ✅ Admin bisa update status (untuk upload completion)
      allow update: if request.auth != null 
                    && isAdminSafe()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      
      // ✅ Admin bisa delete file
      allow delete: if request.auth != null && isAdminSafe();

      // ============================================================
      // CHUNKS SUB-COLLECTION - Potongan data file
      // ============================================================
      match /chunks/{chunkId} {
        // ✅ Admin & Engineer bisa create chunks
        allow create: if request.auth != null 
                      && (isAdminSafe() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'engineer');
        
        // ✅ Semua user bisa read chunks (untuk download)
        allow read: if request.auth != null;
        
        // ✅ Admin bisa delete chunks
        allow delete: if request.auth != null && isAdminSafe();
      }
    }

    // ============================================================
    // SERVICE REPORTS COLLECTION (Approved Reports for TDE/CBRE)
    // ============================================================
    match /service_reports/{reportId} {
      // ✅ Admin bisa upload
      allow create: if request.auth != null && isAdminSafe();
      
      // ✅ Admin, TDE, CBRE bisa read
      allow read: if request.auth != null 
                  && (isAdminSafe() 
                      || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                         && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tde'
                             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cbre')));
      
      // ✅ Admin bisa update (untuk status completed)
      allow update: if request.auth != null && isAdminSafe();
      
      // ✅ Admin bisa delete
      allow delete: if request.auth != null && isAdminSafe();

      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && isAdminSafe();
      }
    }

    // ============================================================
    // CORRECTIVE MAINTENANCE REPORTS
    // ============================================================
    match /corrective_reports/{reportId} {
      // ✅ Create: Only Standby Engineer
      allow create: if request.auth != null && isStandbyEngineer();
      
      // ✅ Read: All authenticated users (Admin, Engineer, Standby)
      allow read: if request.auth != null;
      
      // ✅ Delete: Admin or Owner (Standby Engineer)
      allow delete: if request.auth != null 
                    && (isAdminSafe() || (isStandbyEngineer() && resource.data.reportedBy == request.auth.uid));
    }
    
    // ============================================================
    // SERVICE REPORT TEMPLATES
    // ============================================================
    match /service_report_templates/{templateId} {
      // ✅ Admin can do everything
      allow write: if request.auth != null && isAdminSafe();
      
      // ✅ All authenticated users can read templates
      allow read: if request.auth != null;
    }
    
    // ============================================================
    // HSE COLLECTION - Laporan HSE oleh HSE Officer
    // ============================================================
    match /hse/{reportId} {
      // ✅ HSE user bisa create laporan mereka sendiri
      allow create: if request.auth != null 
                    && (isHSE() || isAdminSafe())
                    && request.resource.data.keys().hasAll(['aktivitas', 'lokasi', 'createdAt', 'authorEmail'])
                    && request.resource.data.authorEmail == request.auth.token.email;
      
      // ✅ HSE user bisa read laporan mereka sendiri, admin bisa read semua
      allow read: if request.auth != null 
                  && (isAdminSafe() 
                      || (isHSE() && resource.data.authorEmail == request.auth.token.email));
      
      // ✅ HSE user bisa update laporan mereka sendiri
      allow update: if request.auth != null 
                    && (isAdminSafe() 
                        || (isHSE() && resource.data.authorEmail == request.auth.token.email));
      
      // ✅ Admin bisa delete, HSE user bisa delete milik mereka sendiri
      allow delete: if request.auth != null 
                    && (isAdminSafe() 
                        || (isHSE() && resource.data.authorEmail == request.auth.token.email));

      // ✅ Subcollection untuk foto (HSE)
      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null 
                              && (get(/databases/$(database)/documents/hse/$(reportId)).data.authorEmail == request.auth.token.email || isAdminSafe());
      }
    }

    // ============================================================
    // DEFAULT - Block semua akses ke collection lain
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
