[debug] [2026-03-26T09:56:10.569Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/report-utt/rulesets {"name":"projects/report-utt/rulesets/eac03006-7c2f-41ba-85f5-89b77a2863fc","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // ============================================================\n    // HELPER FUNCTIONS\n    // ============================================================\n    \n    // ✅ Check if user is admin (safe - returns false if doc doesn't exist)\n    function isAdminSafe() {\n      return request.auth != null \n             && request.auth.uid != null\n             && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n\n    // ✅ Standby Engineer check\n    function isStandbyEngineer() {\n      return request.auth != null \n             && request.auth.uid != null\n             && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'standby_engineer';\n    }\n\n    // ✅ HSE Officer check\n    function isHSE() {\n      return request.auth != null \n             && request.auth.uid != null\n             && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'hse';\n    }\n\n    // ✅ Director check\n    function isDirector() {\n      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;\n      return request.auth != null \n             && request.auth.uid != null\n             && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n             && (role == 'dirut' || role == 'direksiSDM' || role == 'DireksiKeuangan');\n    }\n\n    // ✅ Division specific check\n    function isDivision(div) {\n      return request.auth != null \n             && request.auth.uid != null\n             && exists(/databases/$(database)/documents/users/$(request.auth.uid))\n             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == div;\n    }\n\n    // ============================================================\n    // 🛡️ SECURITY HELPER FUNCTIONS\n    // ============================================================\n    \n    // ✅ Validasi bahwa string tidak lebih dari maxLen karakter\n    // Mencegah penyimpanan data sangat besar yang membebani database\n    function isValidString(val, maxLen) {\n      return val is string && val.size() <= maxLen;\n    }\n\n    // ✅ Validasi foto dataUrl — panjang max 2MB base64 (~2.7MB actual)\n    // Satu karakter base64 = ~0.75 byte, jadi 2MB ≈ 2,800,000 chars\n    function isValidPhotoData(data) {\n      return data is string && data.size() <= 2800000;\n    }\n    \n    // ✅ Validasi bahwa jumlah field tidak berlebihan (anti data flooding)\n    function hasAcceptableFieldCount(data, maxFields) {\n      return data.keys().size() <= maxFields;\n    }\n\n    // ============================================================\n    // USERS COLLECTION\n    // ============================================================\n    match /users/{userId} {\n      allow create: if request.auth != null \n                    && request.auth.uid == userId\n                    && request.resource.data.email == request.auth.token.email\n                    && request.resource.data.uid == userId\n                    && request.resource.data.keys().hasAll(['email', 'uid', 'role', 'companyType', 'createdAt'])\n                    && hasAcceptableFieldCount(request.resource.data, 8)\n                    && (request.resource.data.role == 'admin' || request.resource.data.role == 'engineer' || request.resource.data.role == 'standby_engineer' || request.resource.data.role == 'tde' || request.resource.data.role == 'cbre' || request.resource.data.role == 'hse' || request.resource.data.role == 'pmo' || request.resource.data.role == 'sales' || request.resource.data.role == 'presales' || request.resource.data.role == 'purchasing' || request.resource.data.role == 'dirut' || request.resource.data.role == 'direksiSDM' || request.resource.data.role == 'DireksiKeuangan')\n                    && (request.resource.data.companyType == 'neutra' || request.resource.data.companyType == 'bri')\n                    && isValidString(request.resource.data.email, 200)\n                    && isValidString(request.resource.data.uid, 128);\n      \n      allow read: if request.auth != null \n                  && (request.auth.uid == userId || isAdminSafe() || isStandbyEngineer());\n      \n      allow update: if request.auth != null \n                    && (\n                      (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyType']))\n                      || isAdminSafe()\n                    )\n                    && hasAcceptableFieldCount(request.resource.data, 10);\n      \n      allow delete: if request.auth != null && isAdminSafe();\n    }\n    \n    // ============================================================\n    // EXCEL_DOCUMENTS COLLECTION\n    // ============================================================\n    match /excel_documents/{docId} {\n      allow create: if request.auth != null \n                    && request.resource.data.createdBy == request.auth.token.email\n                    && request.resource.data.keys().hasAll([\n                      'fileName', \n                      'maintenanceName', \n                      'maintenanceTime',\n                      'createdAt',\n                      'createdBy',\n                      'fileSize',\n                      'totalPhotos',\n                      'photosWithImage'\n                    ])\n                    && hasAcceptableFieldCount(request.resource.data, 15)\n                    && isValidString(request.resource.data.fileName, 500)\n                    && isValidString(request.resource.data.maintenanceName, 500)\n                    && isValidString(request.resource.data.createdBy, 200)\n                    && (!request.resource.data.keys().hasAny(['specificDetail']) || request.resource.data.specificDetail is string);\n      \n      allow read, delete: if request.auth != null \n                  && (resource.data.createdBy == request.auth.token.email \n                      || isAdminSafe());\n      \n      allow update: if request.auth != null \n                    && (resource.data.createdBy == request.auth.token.email || isAdminSafe())\n                    && hasAcceptableFieldCount(request.resource.data, 15);\n\n      // ✅ Subcollection foto\n      match /photos/{photoId} {\n        allow read: if request.auth != null;\n        allow create: if request.auth != null\n                      && hasAcceptableFieldCount(request.resource.data, 6)\n                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));\n        allow update, delete: if request.auth != null \n                              && (get(/databases/$(database)/documents/excel_documents/$(docId)).data.createdBy == request.auth.token.email || isAdminSafe());\n      }\n    }\n    \n    // ============================================================\n    // PDF_DOCUMENTS COLLECTION\n    // ============================================================\n    match /pdf_documents/{docId} {\n      allow create: if request.auth != null \n                    && request.resource.data.createdBy == request.auth.token.email\n                    && request.resource.data.keys().hasAll([\n                      'fileName', \n                      'maintenanceName', \n                      'maintenanceTime',\n                      'createdAt',\n                      'createdBy',\n                      'fileSize',\n                      'totalPhotos',\n                      'photosWithImage'\n                    ])\n                    && hasAcceptableFieldCount(request.resource.data, 15)\n                    && isValidString(request.resource.data.fileName, 500)\n                    && isValidString(request.resource.data.maintenanceName, 500)\n                    && isValidString(request.resource.data.createdBy, 200)\n                    && (!request.resource.data.keys().hasAny(['specificDetail']) || request.resource.data.specificDetail is string);\n      \n      allow read, delete: if request.auth != null \n                  && (resource.data.createdBy == request.auth.token.email \n                      || isAdminSafe());\n      \n      allow update: if request.auth != null \n                    && (resource.data.createdBy == request.auth.token.email || isAdminSafe())\n                    && hasAcceptableFieldCount(request.resource.data, 15);\n\n      // ✅ Subcollection foto\n      match /photos/{photoId} {\n        allow read: if request.auth != null;\n        allow create: if request.auth != null\n                      && hasAcceptableFieldCount(request.resource.data, 6)\n                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));\n        allow update, delete: if request.auth != null \n                              && (get(/databases/$(database)/documents/pdf_documents/$(docId)).data.createdBy == request.auth.token.email || isAdminSafe());\n      }\n    }\n    \n    // ============================================================\n    // FILES COLLECTION\n    // ============================================================\n    match /files/{fileId} {\n      allow create: if request.auth != null \n                     && (isAdminSafe() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'engineer' || isStandbyEngineer())\n                    && request.resource.data.keys().hasAll([\n                      'fileName',\n                      'fileSize',\n                      'fileType',\n                      'category',\n                      'uploadedBy',\n                      'uploadedByEmail',\n                      'uploadedAt'\n                    ])\n                    && hasAcceptableFieldCount(request.resource.data, 20)\n                    && request.resource.data.uploadedBy == request.auth.uid\n                    && request.resource.data.uploadedByEmail == request.auth.token.email\n                    && isValidString(request.resource.data.fileName, 500)\n                    && isValidString(request.resource.data.fileType, 100);\n      \n      allow read: if request.auth != null;\n      \n      allow update: if request.auth != null \n                    && isAdminSafe()\n                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);\n      \n      allow delete: if request.auth != null && isAdminSafe();\n\n      // ✅ CHUNKS SUB-COLLECTION\n      match /chunks/{chunkId} {\n        allow create: if request.auth != null \n                      && (isAdminSafe() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'engineer' || isStandbyEngineer())\n                      && hasAcceptableFieldCount(request.resource.data, 10);\n        \n        allow read: if request.auth != null;\n        \n        allow delete: if request.auth != null && isAdminSafe();\n      }\n    }\n\n    // ============================================================\n    // SERVICE REPORTS COLLECTION\n    // ============================================================\n    match /service_reports/{reportId} {\n      allow create: if request.auth != null && isAdminSafe()\n                    && hasAcceptableFieldCount(request.resource.data, 20);\n      \n      allow read: if request.auth != null \n                  && (isAdminSafe() \n                      || (exists(/databases/$(database)/documents/users/$(request.auth.uid))\n                         && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tde'\n                             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'cbre')));\n      \n      allow update: if request.auth != null && isAdminSafe();\n      \n      allow delete: if request.auth != null && isAdminSafe();\n\n      match /chunks/{chunkId} {\n        allow read: if request.auth != null;\n        allow create, delete: if request.auth != null && isAdminSafe();\n      }\n    }\n\n    // ============================================================\n    // CORRECTIVE MAINTENANCE REPORTS\n    // ============================================================\n    match /corrective_reports/{reportId} {\n      allow create: if request.auth != null && isStandbyEngineer()\n                    && hasAcceptableFieldCount(request.resource.data, 20);\n      \n      allow read: if request.auth != null;\n      \n      allow delete: if request.auth != null \n                    && (isAdminSafe() || (isStandbyEngineer() && resource.data.reportedBy == request.auth.uid));\n    }\n    \n    // ============================================================\n    // SERVICE REPORT TEMPLATES\n    // ============================================================\n    match /service_report_templates/{templateId} {\n      allow write: if request.auth != null && isAdminSafe()\n                   && hasAcceptableFieldCount(request.resource.data, 30);\n      \n      allow read: if request.auth != null;\n    }\n    \n    // ============================================================\n    // HSE COLLECTION — Laporan HSE oleh HSE Officer\n    // PUBLIC READ dipertahankan untuk WA link sharing (by design)\n    // ============================================================\n    match /hse/{reportId} {\n      // ✅ HSE user bisa create laporan mereka sendiri\n      allow create: if request.auth != null \n                    && (isHSE() || isAdminSafe())\n                    && request.resource.data.keys().hasAll(['aktivitas', 'lokasi', 'createdAt', 'authorEmail'])\n                    && request.resource.data.authorEmail == request.auth.token.email\n                    && hasAcceptableFieldCount(request.resource.data, 15)\n                    && isValidString(request.resource.data.aktivitas, 500)\n                    && isValidString(request.resource.data.lokasi, 500)\n                    && isValidString(request.resource.data.authorEmail, 200);\n      \n      // ✅ PUBLIC READ — siapapun dengan link bisa lihat (untuk WA sharing)\n      allow read: if true;\n      \n      // ✅ HSE user bisa update laporan mereka sendiri\n      allow update: if request.auth != null \n                    && (isAdminSafe() \n                        || (isHSE() && resource.data.authorEmail == request.auth.token.email))\n                    && hasAcceptableFieldCount(request.resource.data, 15);\n      \n      // ✅ Admin bisa delete, HSE user bisa delete milik mereka sendiri\n      allow delete: if request.auth != null \n                    && (isAdminSafe() \n                        || (isHSE() && resource.data.authorEmail == request.auth.token.email));\n\n      // ✅ Subcollection foto HSE — PUBLIC READ for WA viewer link\n      match /photos/{photoId} {\n        allow read: if true;\n        allow create: if request.auth != null\n                      && hasAcceptableFieldCount(request.resource.data, 6)\n                      && (!request.resource.data.keys().hasAny(['dataUrl']) || isValidPhotoData(request.resource.data.dataUrl));\n        allow update, delete: if request.auth != null \n                              && (get(/databases/$(database)/documents/hse/$(reportId)).data.authorEmail == request.auth.token.email || isAdminSafe());\n      }\n    }\n\n    // ============================================================\n    // ISO DIVISION COLLECTIONS (PMO, SALES, PRESALES, PURCHASING)\n    // ============================================================\n    match /{division}/{fileId} {\n      allow create: if request.auth != null \n                    && division in ['pmo', 'sales', 'presales', 'purchasing']\n                    && (isAdminSafe() || isDivision(division))\n                    && request.resource.data.keys().hasAll(['fileName', 'fileSize', 'fileType', 'uploadedBy', 'uploadedAt'])\n                    && hasAcceptableFieldCount(request.resource.data, 20);\n      \n      allow read: if request.auth != null \n                  && division in ['pmo', 'sales', 'presales', 'purchasing']\n                  && (isAdminSafe() || isDivision(division) || isDirector());\n      \n      allow delete: if request.auth != null && isAdminSafe();\n\n      // ✅ ISO CHUNKS\n      match /chunks/{chunkId} {\n        allow create: if request.auth != null \n                      && division in ['pmo', 'sales', 'presales', 'purchasing']\n                      && (isAdminSafe() || isDivision(division))\n                      && hasAcceptableFieldCount(request.resource.data, 10);\n        \n        allow read: if request.auth != null \n                    && division in ['pmo', 'sales', 'presales', 'purchasing']\n                    && (isAdminSafe() || isDivision(division) || isDirector());\n        \n        allow delete: if request.auth != null && isAdminSafe();\n      }\n    }\n\n    // ============================================================\n    // MAINTENANCE PROGRESS COLLECTION\n    // ============================================================\n    match /maintenance_progress/{docId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null \n                    && (isAdminSafe() \n                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'\n                        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'site_manager');\n    }\n\n    // ============================================================\n    // DEFAULT — Block semua akses ke collection lain\n    // ============================================================\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firebase/firestore.rules"}]},"createTime":"2026-03-26T09:56:09.359743Z","metadata":{"services":["cloud.firestore"]}}
