  "scripts": {
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "test:navigation": "node --test scripts/test-app-navigation.mjs",
    "test:pm-predictive": "node --test scripts/test-pm-predictive-engine.mjs",
