    "export:dev": "vite build --mode development --outDir export/development",
    "backend": "cd backend && .\\server.exe",
    "backend:build": "cd backend && go build -o server.exe ./cmd/api",
    "wagateway": "node backend/wagateway.js",
    "dev": "concurrently --kill-others --names \"FRONTEND,BACKEND\" --prefix-colors \"cyan,green\" \"vite\" \"npm run backend\""
  },
