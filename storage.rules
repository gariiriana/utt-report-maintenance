rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // HSE Reports: authenticated users can upload, anyone with link can read (for WA sharing)
    match /hse_reports/{fileName} {
      allow read: if true;                        // Public read - so WA link works for everyone
      allow write: if request.auth != null        // Only authenticated users can upload
                   && request.resource.size < 20 * 1024 * 1024  // Max 20MB
                   && request.resource.contentType == 'application/pdf';
    }

    // Block semua path lain
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
